local function weightedReward(c)
    local roll = math.random(1, c.total);
    for _, reward in ipairs(c.rewards) do
        if roll <= reward.weight then return reward; end
        roll = roll - reward.weight;
    end
    return c.rewards[#c.rewards];
end

