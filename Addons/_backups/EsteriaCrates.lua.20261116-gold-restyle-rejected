local function flat(parent, width, height, text, primary, name)
    local b = CreateFrame("Button", name, parent);
    b:SetSize(width, height);
    b.primary = primary;
    b.bg = ES.Solid(b, "BACKGROUND", primary and { 0.36, 0.25, 0.06 } or ES.INK, primary and 0.95 or 0.9);
    b.bg:SetAllPoints();
    b.glow = ES.Solid(b, "ARTWORK", ES.GOLD, 0);
    b.glow:SetAllPoints();
    b.lines = ES.Border(b, primary and ES.GOLD or ES.GOLD_DIM);
    b.text = ES.Text(b, primary and 13 or 12, primary and { 1, 0.92, 0.7 } or ES.TEXT);
    b.text:SetPoint("CENTER", 0, 1);
    b.text:SetText(text or "");
    b.shine = FX.Shine(b);
    b:SetScript("OnEnter", function(self)
        if self:IsEnabled() == 1 then self.glow:SetAlpha(0.12); ES.Tint(self.lines, ES.GOLD, 1); self.shine(); end
    end);
    b:SetScript("OnLeave", function(self) self.glow:SetAlpha(0); ES.Tint(self.lines, self.primary and ES.GOLD or ES.GOLD_DIM, 1); end);
    function b:Set(text, on)
        self.text:SetText(text);
        if on then self:Enable(); self.text:SetAlpha(1); self.bg:SetAlpha(self.primary and 0.95 or 0.9);
        else self:Disable(); self.text:SetAlpha(0.35); self.bg:SetAlpha(0.5); self.glow:SetAlpha(0); end
